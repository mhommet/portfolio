---
import HeroButtons from "./HeroButtons";
import HeroText from "./HeroText";
import RotatingSphere from "./RotatingSphere";
---

<section
  id="hero"
  class="w-full min-h-[85vh] flex flex-col items-center pt-16"
>
  <div class="container flex flex-col items-center gap-6">
    <div
      class="flex-shrink-0 flex items-center justify-center"
      style="width:320px;height:320px;max-width:70vw;max-height:50vh;"
    >
      <RotatingSphere client:load />
    </div>
    <div class="flex flex-col items-center justify-center text-center">
      <HeroText client:load />
      <div class="mt-6 flex justify-center">
        <HeroButtons client:load />
      </div>
    </div>
  </div>
</section>
