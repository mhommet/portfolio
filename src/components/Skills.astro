---
import SkillBadges from "./SkillBadges";
import { t } from "../i18n";
import ScrollAnimation from "./ScrollAnimation";

// Récupérer la langue depuis l'URL
const urlPathname = Astro.url.pathname;
const lang = urlPathname.startsWith("/en") ? "en" : "fr";

// Définir les compétences avec les traductions
const skills = {
  // Partie DevOps (inchangée)
  [t("skills.infrastructure", lang)]: ["Docker", "Linux", "Bash"],
  [t("skills.ci_cd", lang)]: ["Gitlab CI/CD", "Github Actions"],
  [t("skills.monitoring", lang)]: ["Grafana", "Prometheus", "Sentry"],

  // Partie Dev (Restructurée)
  [t("skills.languages", lang)]: ["Rust", "Dart", "Python", "PHP", "TypeScript"],
  [t("skills.frameworks", lang)]: ["Tauri", "Flutter", "Electron", "Symfony", "Node.js"],
  [t("skills.databases", lang)]: ["PostgreSQL", "MongoDB", "MySQL"],
  
  // J'ai gardé les tests à part car c'est un point fort DevOps
  [t("skills.testing", lang)]: ["Cypress", "PHPUnit"],
};
---

<section id="skills" class="container rounded-xl">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-center space-y-8 text-center"
  >
    <h2
      class="text-3xl font-bold tracking-tighter sm:text-5xl md:text-6xl md:opacity-0 opacity-100"
    >
      {t("skills.title", lang)}
    </h2>
    <p
      class="max-w-[700px] text-muted-foreground md:text-xl/relaxed lg:text-xl/relaxed xl:text-2xl/relaxed md:opacity-0 opacity-100"
    >
      {t("skills.description", lang)}
    </p>
  </div>
  <div
    class="rounded-xl p-10 mt-16 max-w-5xl mx-auto animate-content md:opacity-0 opacity-100"
  >
    <SkillBadges client:load skills={skills} />
  </div>
  <ScrollAnimation client:load sectionId="skills" />
</section>

